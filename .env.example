# ==========================================
# SUPABASE
# ==========================================
# From your Supabase project: Settings > API (URL, anon key, service_role key)
# and Settings > Database (connection string / password).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PASSWORD=
DATABASE_URL=

# ==========================================
# ADZUNA JOB SEARCH API
# ==========================================
# Register at https://developer.adzuna.com/

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ==========================================
# OPENAI — JOB MATCHING
# ==========================================

OPENAI_API_KEY=
# Low-cost model used for relevance evaluation. Keep this configurable —
# never hardcode a model name in application code.
OPENAI_MATCHING_MODEL=gpt-4o-mini

# ==========================================
# TELEGRAM BOT INTEGRATION
# ==========================================
# TELEGRAM_WEBHOOK_BASE_URL must be a public HTTPS URL (Vercel deployment or a
# tunnel) — Telegram cannot call back into localhost.
# Generate TELEGRAM_WEBHOOK_SECRET and BOT_TOKEN_ENCRYPTION_KEY yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
BOT_TOKEN_ENCRYPTION_KEY=

# ==========================================
# PAYMENT PROVIDER (Paystack)
# ==========================================
# Leave blank until billing is configured. Only the secret key is required for
# the redirect-based checkout flow this project uses.

PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ==========================================
# APPLICATION
# ==========================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails allowed into /admin (must be verified accounts).
ADMIN_EMAILS=
